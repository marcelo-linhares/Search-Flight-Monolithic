{
  "name": "@searchfly/api",
  "version": "1.0.0",
  "description": "SearchFly Node.js DDD monolith (8 bounded contexts)",
  "main": "src/server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --selectProjects unit integration",
    "test:unit": "jest --selectProjects unit --watch",
    "test:integration": "jest --selectProjects integration",
    "test:stage": "jest --selectProjects stage",
    "test:all": "jest",
    "test:coverage": "jest --selectProjects unit integration --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "jest": "^30.4.2",
    "supertest": "^7.3.1"
  },
  "private": true,
  "dependencies": {
    "express": "^5.2.1"
  }
}
