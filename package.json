{
  "name": "searchfly",
  "private": true,
  "version": "0.1.0",
  "resolutions": {
    "react-native-screens": "4.26.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:start": "yarn workspace @searchfly/api start",
    "api:test": "yarn workspace @searchfly/api test",
    "api:coverage": "yarn workspace @searchfly/api test:coverage",
    "api:ledger": "yarn workspace @searchfly/api ledger-service",
    "api:footprint": "yarn workspace @searchfly/api footprint",
    "mobile": "yarn workspace @searchfly/mobile start",
    "typecheck": "yarn workspace @searchfly/mobile tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
